generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
  SPAM
}

enum AdminAuditActorKind {
  ADMIN
}

enum AdminAuditAction {
  CONTENT_UPDATED
  REQUISITES_CHANGED
  PAYMENT_RECONCILE_REQUESTED
  CONTENT_CREATED
  CONTENT_PUBLISHED
  CONTENT_ARCHIVED
  CONTENT_STATUS_CHANGED
  CONTENT_DELETED
  CONTACT_STATUS_CHANGED
  CONTACT_NOTE_CHANGED
}

enum AdminAuditEntityType {
  REQUISITES
  DONATION
  PROJECT
  NEWS_POST
  DOCUMENT
  CONTACT_REQUEST
}

model Donation {
  id                String         @id @default(cuid())
  providerPaymentId String?        @unique
  idempotenceKey    String         @unique
  amountKopecks     Int
  currency          String         @default("RUB")
  status            DonationStatus @default(PENDING)
  donorName         String?
  donorEmail        String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  projectId         String?
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  lastProviderStatus     String?
  lastReconciledAt       DateTime?
  lastReconcileErrorCode String?
  nextReconcileAt        DateTime?
  reconcileAttempts      Int            @default(0)
  claimToken             String?
  claimExpiresAt         DateTime?
  manualReviewRequired   Boolean        @default(false)

  @@index([status, createdAt])
  @@index([status, paidAt])
  @@index([createdAt, id])
  @@index([status, projectId])
  @@index([status, nextReconcileAt, createdAt])
}

model Project {
  id                  String            @id @default(cuid())
  title               String
  slug                String            @unique
  summary             String?
  content             String?
  imageUrl            String?
  status              PublicationStatus @default(DRAFT)
  publishedAt         DateTime?
  goalAmountKopecks   Int?
  manualRaisedKopecks Int            @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  donations           Donation[]

  @@index([status, publishedAt, id])
}

model NewsPost {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  summary     String?
  content     String?
  imageUrl    String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt, id])
}

model Document {
  id          String            @id @default(cuid())
  title       String
  category    String
  fileUrl     String
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt, id])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id           String               @id @default(cuid())
  name         String
  email        String
  message      String
  status       ContactRequestStatus @default(NEW)
  internalNote String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt, id])
  @@index([createdAt, id])
  @@index([name(ops: raw("public.gin_trgm_ops"))], map: "ContactRequest_name_trgm_idx", type: Gin)
  @@index([email(ops: raw("public.gin_trgm_ops"))], map: "ContactRequest_email_trgm_idx", type: Gin)
  @@index([message(ops: raw("public.gin_trgm_ops"))], map: "ContactRequest_message_trgm_idx", type: Gin)
}

model AdminAuditEvent {
  id             String               @id @default(cuid())
  actorKind      AdminAuditActorKind  @default(ADMIN)
  action         AdminAuditAction
  entityType     AdminAuditEntityType
  entityId       String
  previousStatus String?
  nextStatus     String?
  changedFields  String[]             @default([])
  createdAt      DateTime             @default(now())

  @@index([createdAt, id])
  @@index([entityType, entityId, createdAt])
}

model PaymentRateLimitBucket {
  key         String
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
