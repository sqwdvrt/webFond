generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum AdminRole {
  ADMIN
  EDITOR
}

model Donation {
  id                String         @id @default(cuid())
  providerPaymentId String?        @unique
  idempotenceKey    String         @unique
  amountKopecks     Int
  currency          String         @default("RUB")
  status            DonationStatus @default(PENDING)
  donorName         String?
  donorEmail        String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
}

model Project {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  summary     String?
  content     String?
  imageUrl    String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model NewsPost {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  summary     String?
  content     String?
  imageUrl    String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Document {
  id          String    @id @default(cuid())
  title       String
  category    String
  fileUrl     String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  email     String
  message   String
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
