generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum DonationStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactRequestStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model Donation {
  id                String         @id @default(cuid())
  providerPaymentId String?        @unique
  idempotenceKey    String         @unique
  amountKopecks     Int
  currency          String         @default("RUB")
  status            DonationStatus @default(PENDING)
  donorName         String?
  donorEmail        String?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([createdAt, id])
}

model Project {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  summary     String?
  content     String?
  imageUrl    String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt, id])
}

model NewsPost {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  summary     String?
  content     String?
  imageUrl    String?
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt, id])
}

model Document {
  id          String            @id @default(cuid())
  title       String
  category    String
  fileUrl     String
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, publishedAt, id])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  email     String
  message   String
  status    ContactRequestStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}

model PaymentRateLimitBucket {
  key         String
  windowStart DateTime
  count       Int
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
}
