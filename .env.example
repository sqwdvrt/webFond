# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
AUTH_SECRET=""
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_TRUST_PROXY="false"

# Payments
PAYMENTS_ENABLED=false
PAYMENTS_OFFER_VERSION=
PAYMENTS_RATE_LIMIT_SECRET=
PAYMENTS_TRUST_PROXY=false

# PostgreSQL
# Locally both URLs may point at the same database.
# On Vercel/Neon: DATABASE_URL is the pooled host (-pooler) with pgbouncer=true
# and connect_timeout=15. DATABASE_URL_UNPOOLED is the direct host for
# `prisma migrate deploy`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/byt_dobru?schema=public"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/byt_dobru?schema=public"

# YooKassa: server-side only. Never expose these values with NEXT_PUBLIC_*.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
YOOKASSA_RETURN_URL="http://localhost:3000/donation/result"
